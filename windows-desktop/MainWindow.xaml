        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="اف Ai"
        Icon="pack://application:,,,/app.ico"
        Height="850" Width="1440" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="#111018">
    <Grid>
        <wv2:WebView2 x:Name="Browser"/>
        <Border x:Name="LoadingPanel" Background="#111018" Panel.ZIndex="2">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="اف Ai" Foreground="#12C982" FontSize="42"
                           FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="در حال اتصال به Fizer.ir..." Foreground="#D8D5E2"
                           FontSize="15" Margin="0,14,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
